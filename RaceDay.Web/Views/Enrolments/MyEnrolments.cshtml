@model IEnumerable<RaceDay.Web.Models.EnrolmentDto>
@{
    ViewData["Title"] = "My Enrolments";
}

<div class="container mt-5">
    <h2 class="mb-4">My Race Enrolments</h2>

    @if (!Model.Any())
    {
        <div class="alert alert-info">You haven't enrolled in any events yet. <a asp-controller="Home" asp-action="Index">Browse Events</a></div>
    }
    else
    {
        <table class="table table-hover shadow-sm">
            <thead class="table-dark">
                <tr>
                    <th>Event</th>
                    <th>Category</th>
                    <th>Status</th>
                    <th>Payment</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td class="fw-bold">@item.EventName</td>
                        <td>@item.CategoryName</td>
                        <td><span class="badge bg-success">@item.Status</span></td>
                        <td><span class="badge bg-warning text-dark">@item.PaymentStatus</span></td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>