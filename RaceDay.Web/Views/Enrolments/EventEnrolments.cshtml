@model IEnumerable<dynamic>
@{
    ViewData["Title"] = "Results Board";
}

<div class="container mt-5">
    <h2 class="text-center text-primary fw-bold">Results Board</h2>
    <hr />

    @if (!Model.Any())
    {
        <div class="alert alert-info text-center">No results have been captured for this event yet.</div>
    }
    else
    {
        <table class="table table-striped table-hover shadow-sm mt-4">
            <thead class="table-dark">
                <tr>
                    <th>Pos</th>
                    <th>Participant</th>
                    <th>Category</th>
                    <th>Finish Time</th>
                    <th>Pace</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td class="fw-bold">@item.overallPosition</td>
                        <td>@item.participantName</td>
                        <td>@item.categoryName</td>
                        <td class="fw-bold text-success">@item.finishTime</td>
                        <td>@item.pace</td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>