@using Microsoft.AspNetCore.Http
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - RaceDay</title>

    <!-- Added Bootstrap Icons for a more professional look -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/RaceDay.Web.styles.css" asp-append-version="true" />

    <style>
        /* Custom subtle hover effect for the navbar links */
        .nav-link {
            transition: color 0.2s ease-in-out;
        }

            .nav-link:hover {
                color: #ffc107 !important; /* Bootstrap Warning Yellow */
            }
    </style>
</head>
<body class="d-flex flex-column min-vh-100 bg-light">
    <header>
        <!-- Dark Navbar with a shadow, stuck to the top -->
        <nav class="navbar navbar-expand-lg navbar-dark bg-dark shadow-sm sticky-top">
            <div class="container">
                <!-- Brand Logo -->
                <a class="navbar-brand fw-bold fs-4" asp-area="" asp-controller="Home" asp-action="Index">
                    <i class="bi bi-stopwatch text-warning me-2"></i>RaceDay
                </a>

                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <!-- Left Side Links -->
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="Home" asp-action="Index">Home</a>
                        </li>

                        @if (Context.Session.GetString("JWToken") != null)
                        {
                            var role = Context.Session.GetString("UserRole");

                            if (role == "Organiser")
                            {
                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="Organiser" asp-action="Index"><i class="bi bi-speedometer2 me-1"></i> Dashboard</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link text-warning" asp-controller="Events" asp-action="Create"><i class="bi bi-plus-circle me-1"></i> Create Event</a>
                                </li>
                            }
                            else if (role == "Participant")
                            {
                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="Enrolments" asp-action="MyEnrolments"><i class="bi bi-list-check me-1"></i> My Enrolments</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="Enrolments" asp-action="MyResults"><i class="bi bi-trophy me-1"></i> My Results</a>
                                </li>
                            }
                        }
                    </ul>

                    <!-- Right Side Links (Auth) -->
                    <ul class="navbar-nav">
                        @if (Context.Session.GetString("JWToken") == null)
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Account" asp-action="Login">Login</a>
                            </li>
                            <li class="nav-item">
                                <a class="btn btn-outline-light btn-sm mt-1 ms-2 px-3 rounded-pill" asp-controller="Account" asp-action="Register">Register</a>
                            </li>
                        }
                        else
                        {
                            var role = Context.Session.GetString("UserRole");
                            <li class="nav-item d-flex align-items-center me-3">
                                <span class="badge bg-secondary text-light border border-light">
                                    <i class="bi bi-person-circle me-1"></i>@role
                                </span>
                            </li>
                            <li class="nav-item">
                                <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                                    <button type="submit" class="nav-link btn btn-link text-danger fw-bold"><i class="bi bi-box-arrow-right me-1"></i>Logout</button>
                                </form>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <!-- Main Content Area -->
    <main role="main" class="container flex-grow-1 pb-5 pt-4">
        @RenderBody()
    </main>

    <!-- Sticky Footer -->
    <footer class="footer mt-auto py-3 bg-white border-top shadow-sm">
        <div class="container text-center text-muted">
            &copy; 2026 - RaceDay System - <a asp-area="" asp-controller="Home" asp-action="Privacy" class="text-decoration-none">Privacy Policy</a>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
