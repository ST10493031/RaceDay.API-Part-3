@model IEnumerable<dynamic>
@{
    ViewData["Title"] = "Event Enrolments";
}

<div class="container mt-4">
    <h2>Event Enrolments</h2>
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }

    <table class="table table-bordered shadow-sm mt-3">
        <thead class="table-dark">
            <tr>
                <th>Participant</th>
                <th>Category</th>
                <th>Status</th>
                <th>Action</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.participantName</td>
                    <td>@item.categoryName</td>
                    <td><span class="badge bg-info text-dark">@item.status</span></td>
                    <td>
                        <a asp-action="CaptureResult" asp-route-enrolmentId="@item.enrolmentID" asp-route-eventId="@ViewBag.EventId" class="btn btn-sm btn-primary">Capture Result</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
    <a asp-action="Index" class="btn btn-secondary">Back to Dashboard</a>
</div>