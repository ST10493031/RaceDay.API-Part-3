@model IEnumerable<RaceDay.Web.Models.EventDto>
@{
    ViewData["Title"] = "Organiser Dashboard";
}

<div class="container mt-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Organiser Dashboard</h2>
        <a asp-controller="Events" asp-action="Create" class="btn btn-success">+ Create Event</a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }

    <div class="row">
        @if (!Model.Any())
        {
            <div class="col-12"><p class="text-muted">You haven't created any events yet.</p></div>
        }
        @foreach (var ev in Model)
        {
            <div class="col-md-6 mb-4">
                <div class="card shadow-sm h-100">
                    <div class="card-body">
                        <h5 class="card-title text-primary">@ev.EventName</h5>
                        <p class="text-muted small">@ev.EventDate.ToShortDateString() | @ev.Location</p>

                        <div class="mt-3">
                            <a asp-controller="Organiser" asp-action="EventEnrolments" asp-route-eventId="@ev.EventID" class="btn btn-sm btn-outline-dark">View Enrolments</a>
                            <a asp-controller="Events" asp-action="Details" asp-route-id="@ev.EventID" class="btn btn-sm btn-outline-primary">View Public Page</a>
                            <a asp-controller="Organiser" asp-action="CreateCategory" asp-route-eventId="@ev.EventID" class="btn btn-sm btn-outline-success">+ Add Category</a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>