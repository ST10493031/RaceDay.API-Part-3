@model RaceDay.Web.Models.CreateCategoryDto
@{
    ViewData["Title"] = "Add Category";
}

<div class="row justify-content-center mt-5">
    <div class="col-md-5">
        <h2 class="text-center">Add Category to Event</h2>
        <hr />
        <form asp-action="CreateCategory" method="post">
            <input type="hidden" name="eventId" value="@ViewBag.EventId" />
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="form-group mb-3">
                <label asp-for="CategoryName" class="control-label">Category Name</label>
                <input asp-for="CategoryName" class="form-control" placeholder="e.g. Senior Male 10km" />
            </div>
            <div class="form-group mb-3">
                <label asp-for="Distance" class="control-label">Distance (km)</label>
                <input asp-for="Distance" class="form-control" type="number" step="0.1" />
            </div>
            <div class="row">
                <div class="col-md-6 form-group mb-3">
                    <label asp-for="MinAge" class="control-label">Min Age</label>
                    <input asp-for="MinAge" class="form-control" type="number" />
                </div>
                <div class="col-md-6 form-group mb-3">
                    <label asp-for="MaxAge" class="control-label">Max Age</label>
                    <input asp-for="MaxAge" class="form-control" type="number" />
                </div>
            </div>
            <div class="form-group mb-3">
                <label asp-for="EntryFee" class="control-label">Entry Fee (R)</label>
                <input asp-for="EntryFee" class="form-control" type="number" step="0.01" />
            </div>

            <button type="submit" class="btn btn-success w-100">Save Category</button>
        </form>
    </div>
</div>